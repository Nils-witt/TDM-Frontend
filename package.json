    "@lezer/highlight": "1.2.5",
    "@mui/material": "9.5.0",
    "@taktische-zeichen/core": "^0.11.0",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@xyflow/react": "12.12.1",
    "codemirror": "6.0.2",
    "idb": "^8.0.4",
    "maplibre-gl": "^6.17.0",
